<Project Sdk="Microsoft.NET.Sdk">
  <!-- Test-only mod. No project reference to HD and no live-game deployment target. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <AssemblyName>HaulersDream.RuntimeHarness</AssemblyName>
    <RootNamespace>HaulersDream.RuntimeHarness</RootNamespace>
    <Version>0.1.0</Version>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Deterministic>true</Deterministic>
    <GameManagedDirectory Condition="'$(GameManagedDirectory)' == ''">C:\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed</GameManagedDirectory>
    <RuntimeHarmonyAssembly Condition="'$(RuntimeHarmonyAssembly)' == ''">C:\Steam\steamapps\workshop\content\294100\2009463077\Current\Assemblies\0Harmony.dll</RuntimeHarmonyAssembly>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameManagedDirectory)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManagedDirectory)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(GameManagedDirectory)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ScreenCaptureModule">
      <HintPath>$(GameManagedDirectory)\UnityEngine.ScreenCaptureModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(GameManagedDirectory)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Runtime.Serialization" />
    <!-- Test observers only; runtime always uses the explicitly selected Harmony mod. -->
    <Reference Include="0Harmony">
      <HintPath>$(RuntimeHarmonyAssembly)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="RecordGameReference" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('$(GameManagedDirectory)\Assembly-CSharp.dll')" Text="Set GameManagedDirectory to the actual RimWorld Managed directory." />
    <GetFileHash Files="$(GameManagedDirectory)\Assembly-CSharp.dll" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_RuntimeReferenceHash" />
    </GetFileHash>
    <WriteLinesToFile File="$(IntermediateOutputPath)RuntimeReferenceIdentity.g.cs"
      Lines="[assembly: System.Reflection.AssemblyMetadataAttribute(&quot;GameReferenceSha256&quot;, &quot;%(_RuntimeReferenceHash.FileHash)&quot;)]"
      Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)RuntimeReferenceIdentity.g.cs" />
    </ItemGroup>
  </Target>
</Project>
