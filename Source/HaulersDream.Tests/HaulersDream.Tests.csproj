<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Headless NUnit tests for HaulersDream.Core. Targets net48 so it runs on the same framework the
    mod ships against (the .NET Framework 4.8 runtime is present on Windows). NOT shipped: no
    OutputPath into the mod, IsPackable false. Run with: dotnet test.
  -->
  <PropertyGroup>
    <AssemblyName>HaulersDream.Tests</AssemblyName>
    <RootNamespace>HaulersDream.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="4.2.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="8.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HaulersDream.Core\HaulersDream.Core.csproj" />
    <!-- Inspect the actual compiled mod without loading it into the NUnit test host. -->
    <ProjectReference Include="..\HaulersDream\HaulersDream.csproj" ReferenceOutputAssembly="false" Private="false" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <!-- Metadata-only inputs stay in the test output. No game install, reference DLL copy, or mod
       deployment is needed in CI; ResolveReferences supplies the existing Krafs/NuGet paths. -->
  <Target Name="WriteOptionalApiMetadataInputs" AfterTargets="Build">
    <MSBuild Projects="..\HaulersDream\HaulersDream.csproj" Targets="GetTargetPath;ResolveReferences"
             Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_OptionalApiMetadataInputs" />
    </MSBuild>
    <WriteLinesToFile File="$(TargetDir)OptionalApiMetadataInputs.txt"
                      Lines="$(MSBuildProjectDirectory)\..\HaulersDream;@(_OptionalApiMetadataInputs)" Overwrite="true" />
  </Target>
</Project>
