+def mouse_messages(value,width,height):
+    action=value['action'];assert action in ('click','drag')
+    x,y=value['x'],value['y']
+    assert all(isinstance(v,(int,float)) and math.isfinite(v) for v in (x,y))
+    x,y=round(x),round(y);assert 0<=x<width and 0<=y<height
+    end=(y<<16)|(x&65535)
+    if action=='click':return [(0x200,0,end),(0x201,1,end),(0x202,0,end)]
+    assert value['control']=='slider','Only the actual slider admits a drag.'
+    bounds=[value[k] for k in ('minX','minY','maxX','maxY')]
+    assert all(isinstance(v,(int,float)) and math.isfinite(v) for v in bounds)
+    left,top,right,bottom=bounds
+    assert 0<=left<right<=width and 0<=top<bottom<=height and left<=x<right and top<=y<bottom
+    start_x,start_y=round((left+right)/2),round((top+bottom)/2)
+    assert (start_x,start_y)!=(x,y),'Slider gesture requires a real displacement.'
+    start=(start_y<<16)|(start_x&65535)
+    return [(0x200,0,start),(0x201,1,start),(0x200,1,end),(0x202,0,end)]
 
