+def start_filetime(stamp):
+    match=re.fullmatch(r'(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d)\.(\d{7})Z',stamp)
+    assert match,'Exact native controller UTC timestamp required.'
+    delta=datetime.datetime.strptime(match[1],'%Y-%m-%dT%H:%M:%S')-datetime.datetime(1601,1,1)
+    return (delta.days*86400+delta.seconds)*10_000_000+int(match[2])
+
