+        private void ControlEnvironment()
+        {
+            Guard(!map.IsPocketMap && map.Tile.Layer is SurfaceLayer && !map.Biome.constantOutdoorTemperature.HasValue
+                && NoTemperatureConditions(), "Ordinary private tile without temperature-offset conditions required.");
+            var temperatures = Find.World.tileTemperatures;
+            temperatures.ClearCaches();
+            float before = map.mapTemperature.OutdoorTemp, minimum = float.MaxValue, maximum = float.MinValue;
+            environmentEndAbs = checked(ticks.TicksAbs + 80000);
+            // All integer ticks across the three bounded processes, rather than selecting a lucky Quicktest world.
+            for (int tick = ticks.TicksAbs; tick <= environmentEndAbs; tick++)
+            {
+                float value = temperatures.OutdoorTemperatureAt(map.Tile, tick);
+                Guard(!float.IsNaN(value) && !float.IsInfinity(value), "Native temperature forecast is not finite.");
+                minimum = Math.Min(minimum, value); maximum = Math.Max(maximum, value);
+            }
+            float offset = 20f - (minimum + maximum) / 2f;
+            // SurfaceLayer serializes temperature to tenths with a 300-degree offset. Select its exact reload value now.
+            int packedMean = Mathf.Clamp(Mathf.RoundToInt((map.TileInfo.temperature + offset + 300f) * 10f), 0, 65535);
+            float selectedMean = packedMean / 10f - 300f; offset = selectedMean - map.TileInfo.temperature;
+            Guard(minimum + offset >= 8.5f && maximum + offset <= 29.5f, "Native forecast range cannot fit the controlled temperature envelope.");
+            originalTileTemperature = map.TileInfo.temperature; environmentOriginalMean = F(originalTileTemperature.Value);
+            map.TileInfo.temperature = selectedMean; temperatures.ClearCaches();
+            ObserveEnvironment();
+            Require("controlled-native-temperature", Math.Abs(map.mapTemperature.OutdoorTemp - (before + offset)) < 0.001f,
+                "Explicit fixture world input: originalTileMean=" + environmentOriginalMean + "; controlledTileMean=" + F(map.TileInfo.temperature)
+                + "; beforeOutdoor=" + F(before) + "; actualOutdoor=" + F(map.mapTemperature.OutdoorTemp)
+                + "; forecastMin=" + F(minimum + offset) + "; forecastMax=" + F(maximum + offset)
+                + "; forecastEndAbs=" + environmentEndAbs + "; samples=80001; nativePackedTileMean=" + packedMean + "; native medical guards remain active.");
+        }
+        private void ObserveEnvironment()
+        {
+            Guard(ticks.TicksAbs <= environmentEndAbs && NoTemperatureConditions(),
+                "Native scene exceeded its temperature forecast or acquired a temperature-offset condition.");
+            float outdoor = map.mapTemperature.OutdoorTemp;
+            Guard(outdoor >= 8f && outdoor <= 30f, "Native outdoor scene left controlled range: " + F(outdoor));
+            observedAmbientMin = Math.Min(observedAmbientMin, outdoor); observedAmbientMax = Math.Max(observedAmbientMax, outdoor);
+            foreach (var actor in actors.Where(p => p != null && p.Spawned))
+            {
+                float ambient = actor.AmbientTemperature;
+                Guard(ambient >= 8f && ambient <= 30f, "Native worker ambient temperature left controlled range: " + actor.ThingID + ":" + F(ambient));
+                observedAmbientMin = Math.Min(observedAmbientMin, ambient); observedAmbientMax = Math.Max(observedAmbientMax, ambient);
+            }
+        }
+        private bool NoTemperatureConditions() => map.gameConditionManager.ActiveConditions
+            .Concat(Find.World.gameConditionManager.ActiveConditions).All(condition => condition.TemperatureOffset() == 0f);
