+function Assert-RobotAutomaticPreparedProfile($Manifest) {
+    Assert-RobotAutomaticFields $Manifest @{robotAutomaticProfile='object';runDirectory='string';runtimeDirectory='string';caseId='string';expectedBehavior='string';negativeControl='string';hdSource='string';expectedAssemblies='array'} 'prepared manifest'
