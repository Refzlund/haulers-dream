+    $taskR1Path=Join-Path $Manifest.runDirectory 'robot-r1-profile.json'
+    if ($taskR1Proof.preparedPath -cne $taskR1Path) { throw 'R1 prepared bound profile path changed.' }
+    $taskR1Admission=[pscustomobject]@{path=$taskR1Proof.sourcePath;bytes=$taskR1Proof.bytes;sha256=$taskR1Proof.sha256}
+    Assert-RobotAutomaticFields $taskR1Admission @{path='string';bytes='integer';sha256='string'} 'prepared admission'
+    if ($taskR1Admission.bytes -le 0 -or $taskR1Admission.bytes -gt 65536 -or $taskR1Admission.sha256 -cnotmatch '^[0-9A-F]{64}$') { throw 'R1 prepared profile admission receipt invalid.' }
+    $taskR1Snapshot=Read-RobotAutomaticProfileSnapshot $taskR1Path
+    if ($taskR1Snapshot.bytes -ne $taskR1Admission.bytes -or $taskR1Snapshot.sha256 -cne $taskR1Admission.sha256) { throw 'R1 copied profile differs from the original admitted bytes.' }
+    $taskR1Encoding=New-Object Text.UTF8Encoding($false,$true)
+    $taskR1Text=$taskR1Encoding.GetString($taskR1Snapshot.data)
+    if ($taskR1Text.Length -gt 0 -and $taskR1Text[0] -eq [char]0xFEFF) { $taskR1Text=$taskR1Text.Substring(1) }
+    if (-not $taskR1Text.TrimStart().StartsWith('{',[StringComparison]::Ordinal)) { throw 'R1 copied profile JSON root must be an object.' }
+    $taskR1=$taskR1Text | ConvertFrom-Json
+    Assert-RobotAutomaticProfileFields $taskR1
+    if ($taskR1.status -cne 'bound-reviewed' -or $taskR1.caseId -cne 'ROBOTS-R1-AUTO' -or $taskR1.schemaVersion -ne 1 -or
+        $Manifest.caseId -cne 'ROBOTS-R1-AUTO' -or $Manifest.expectedBehavior -cne 'satisfied' -or $Manifest.negativeControl -cne 'None' -or $Manifest.hdSource -cne 'Built') { throw 'R1 prepared expectation/profile differs.' }
+    foreach ($taskR1Image in $Manifest.expectedAssemblies) {
+        Assert-RobotAutomaticFields $taskR1Image @{name='string';path='string';sha256='string';moduleVersionId='string';assemblyVersion='string'} 'prepared assembly identity'
+        if ($taskR1Image.sha256 -cnotmatch '^[0-9A-F]{64}$') { throw 'R1 prepared assembly SHA format differs.' }
+    }
+    foreach ($taskR1Pair in @(@('HaulersDream','FC67EE36892115FF45E869761C40C609C84703EDC5D3F00A3F3F9DC1CC6FF8EA'),@('HaulersDream.Core','9205B96D1D871894EAC491A7CEBD0020381DCB6827356CBA7CEA19086A8DC85F'),@('HaulersDream.RuntimeHarness',$taskR1.harness.sha256))) {
+        $taskR1Image=@($Manifest.expectedAssemblies | Where-Object name -CEQ $taskR1Pair[0])
+        if ($taskR1Image.Count -ne 1 -or $taskR1Image[0].sha256 -cne $taskR1Pair[1]) { throw 'R1 prepared payload identity differs.' }
+        if ($taskR1Pair[0] -ceq 'HaulersDream.RuntimeHarness' -and ($taskR1Image[0].moduleVersionId -cne $taskR1.harness.moduleVersionId -or $taskR1Image[0].assemblyVersion -cne $taskR1.harness.assemblyVersion)) { throw 'R1 actual prepared harness MVID/version differs.' }
+    }
+    if ((Get-Sha256 (Join-Path $Manifest.runtimeDirectory 'Mods\HaulersDream\Patches\MiscRobots.xml')) -cne 'FA61E7CF7963C834B10715768D355C33896281B25CEBF2F37DA19DA79F845CBB') { throw 'R1 copied component XML differs.' }
