-    if (-not $taskPath.StartsWith($taskParent + [IO.Path]::DirectorySeparatorChar, [StringComparison]::OrdinalIgnoreCase)) {
-        throw "Path is outside the expected directory: $taskPath (parent $taskParent)"
-    }
