+function Assert-NoReparsePath([string]$Path) {
+    $taskCurrent = Get-CanonicalPath $Path
+    # Get-CanonicalPath trims separators. Restore a root's absolute spelling,
+    # so C:\ is inspected as the root rather than as drive-relative C:.
+    $taskRoot = [IO.Path]::GetPathRoot([IO.Path]::GetFullPath($Path))
+    if ($taskCurrent -ceq $taskRoot.TrimEnd('\', '/')) { $taskCurrent = $taskRoot }
+    while ($taskCurrent) {
+        $taskAttributes = $null
+        try { $taskAttributes = [IO.File]::GetAttributes($taskCurrent) }
+        catch {
+            $taskAttributeError = $_.Exception.GetBaseException()
+            if ($taskAttributeError -isnot [IO.FileNotFoundException] -and
+                $taskAttributeError -isnot [IO.DirectoryNotFoundException]) { throw }
+            # Missing destinations are allowed; every existing ancestor is
+            # still inspected independently on this invocation.
+        }
+        if ($null -ne $taskAttributes -and
+            ($taskAttributes -band [IO.FileAttributes]::ReparsePoint) -ne 0) {
+            throw "Reparse points are not permitted: $taskCurrent"
+        }
+        $taskCurrent = [IO.Path]::GetDirectoryName($taskCurrent)
+    }
+}
+
+function Get-Sha256([string]$Path) {
+    Assert-NoReparsePath $Path
+    return (Get-FileHash -LiteralPath $Path -Algorithm SHA256).Hash
+}
+
+function Write-NewText([string]$Path, [string]$Text) {
+    Assert-ChildPath $Path $taskBase
+    Assert-NoReparsePath $Path
+    $taskBytes = $taskUtf8.GetBytes($Text)
+    $taskStream = [IO.File]::Open($Path, [IO.FileMode]::CreateNew, [IO.FileAccess]::Write, [IO.FileShare]::Read)
+    try { $taskStream.Write($taskBytes, 0, $taskBytes.Length); $taskStream.Flush($true) }
+    finally { $taskStream.Dispose() }
+}
+
+function Write-NewJson([string]$Path, $Value) {
+    Write-NewText $Path ($Value | ConvertTo-Json -Depth 20)
+}
+
+function Write-RunState([string]$Path, $Value) {
+    # Atomic replacement is confined to this run's own controller-state file.
+    Assert-ChildPath $Path $taskBase
+    Assert-NoReparsePath $Path
+    $taskTemporary = $Path + '.' + [guid]::NewGuid().ToString('N') + '.tmp'
+    Write-NewJson $taskTemporary $Value
+    if (Test-Path -LiteralPath $Path) {
+        # PowerShell binds a null string argument to an empty path on some runtimes.
+        # Keep a uniquely named prior state as evidence and pass a real backup path.
+        $taskPrevious = $Path + '.' + [guid]::NewGuid().ToString('N') + '.previous'
+        Assert-ChildPath $taskPrevious $taskBase
+        Assert-NoReparsePath $taskPrevious
+        [IO.File]::Replace($taskTemporary, $Path, $taskPrevious)
+    }
+    else { [IO.File]::Move($taskTemporary, $Path) }
+}
+
+function Copy-VerifiedFile([string]$Source, [string]$Destination, [string]$Role) {
+    Assert-NoReparsePath $Source
+    Assert-ChildPath $Destination $script:taskRun
+    Assert-NoReparsePath $Destination
+    if (Test-Path -LiteralPath $Destination) { throw "Copy destination already exists: $Destination" }
+    $taskHash = Get-Sha256 $Source
+    [IO.Directory]::CreateDirectory((Split-Path -Parent $Destination)) | Out-Null
+    [IO.File]::Copy($Source, $Destination, $false)
+    if ((Get-Sha256 $Destination) -ne $taskHash) { throw "Copy verification failed: $Destination" }
+    $taskCopiedFiles.Add([pscustomobject]@{ role = $Role; sourcePath = $Source; path = $Destination; sha256 = $taskHash })
+}
+
+function Copy-VerifiedTree([string]$Source, [string]$Destination, [string]$Role) {
+    Assert-NoReparsePath $Source
+    Assert-ChildPath $Destination $script:taskRun
+    if (-not (Test-Path -LiteralPath $Source -PathType Container)) { throw "Missing source directory: $Source" }
+    [IO.Directory]::CreateDirectory($Destination) | Out-Null
+    foreach ($taskEntry in Get-ChildItem -LiteralPath $Source -Force) {
+        if (($taskEntry.Attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0) { throw "Refusing linked source: $($taskEntry.FullName)" }
+        $taskDestination = Join-Path $Destination $taskEntry.Name
+        if ($taskEntry.PSIsContainer) { Copy-VerifiedTree $taskEntry.FullName $taskDestination $Role }
+        else { Copy-VerifiedFile $taskEntry.FullName $taskDestination $Role }
+    }
+}
+
+function Copy-HdContent([string]$Source, [string]$Destination) {
+    # Exact shipped trees. Never copy source control, credentials, saves or investigation data.
+    foreach ($taskTree in @('About', 'Defs', 'Patches', 'Languages', 'Textures')) {
+        $taskSourceTree = Join-Path $Source $taskTree
+        if (Test-Path -LiteralPath $taskSourceTree) { Copy-VerifiedTree $taskSourceTree (Join-Path $Destination $taskTree) 'hd' }
+    }
+    Copy-VerifiedFile (Join-Path $Source 'LoadFolders.xml') (Join-Path $Destination 'LoadFolders.xml') 'hd'
+    foreach ($taskDll in Get-ChildItem -LiteralPath (Join-Path $Source '1.6\Assemblies') -File -Filter '*.dll') {
+        Copy-VerifiedFile $taskDll.FullName (Join-Path $Destination ('1.6\Assemblies\' + $taskDll.Name)) 'hd'
+    }
+    foreach ($taskRequired in @('About\About.xml', '1.6\Assemblies\HaulersDream.dll', '1.6\Assemblies\HaulersDream.Core.dll')) {
+        if (-not (Test-Path -LiteralPath (Join-Path $Destination $taskRequired))) { throw "Incomplete HD content: $taskRequired" }
+    }
+}
+
+function Get-AssemblyIdentity([string]$Path) {
+    $taskName = [Reflection.AssemblyName]::GetAssemblyName($Path)
+    return [pscustomobject]@{
+        name = $taskName.Name; path = $Path; sha256 = Get-Sha256 $Path
+        assemblyVersion = $taskName.Version.ToString()
+    }
+}
+
+function Read-RobotMetadataReceipt([string]$Path, $Expected) {
+    Assert-NoReparsePath $Path
+    $taskInfo = Get-Item -LiteralPath $Path
+    if ($taskInfo.PSIsContainer -or $taskInfo.Length -le 0 -or $taskInfo.Length -gt 65536) { throw 'R0 metadata receipt size/type invalid.' }
+    $taskReceipt = [IO.File]::ReadAllText($Path, (New-Object Text.UTF8Encoding($false,$true))) | ConvertFrom-Json
+    $taskFields = @('schemaVersion','status','path','name','assemblyVersion','moduleVersionId','sha256Before','sha256After','bytes','reflectionOnly','moduleCount','reflectionOnlyAssemblyCount','workerVersion','workerEdition','pointerSize','error')
+    if (@($taskReceipt.PSObject.Properties).Count -ne $taskFields.Count) { throw 'R0 metadata receipt field census differs.' }
+    foreach ($taskField in $taskFields) { if (-not $taskReceipt.PSObject.Properties[$taskField]) { throw ('Missing R0 metadata field: '+$taskField) } }
+    foreach ($taskField in @('schemaVersion','bytes','moduleCount','reflectionOnlyAssemblyCount','pointerSize')) {
+        if ($taskReceipt.$taskField -isnot [int] -and $taskReceipt.$taskField -isnot [long]) { throw ('R0 integral metadata field has wrong type: '+$taskField) }
+    }
+    foreach ($taskField in @('status','workerEdition','sha256Before','sha256After')) {
+        if ($taskReceipt.$taskField -isnot [string]) { throw ('R0 scalar string metadata field has wrong type: '+$taskField) }
+    }
+    $taskGuid=[guid]::Empty
+    if ($taskReceipt.moduleVersionId -isnot [string] -or -not [guid]::TryParseExact($taskReceipt.moduleVersionId,'D',[ref]$taskGuid) -or
+        $taskGuid -eq [guid]::Empty -or $taskReceipt.moduleVersionId -cne $taskGuid.ToString('D')) { throw 'Canonical nonempty prepared MVID required.' }
+    if ($taskReceipt.schemaVersion -ne 1 -or $taskReceipt.status -cne 'passed' -or $null -ne $taskReceipt.error -or
+        $taskReceipt.reflectionOnly -isnot [bool] -or -not $taskReceipt.reflectionOnly -or
+        $taskReceipt.moduleCount -ne 1 -or $taskReceipt.reflectionOnlyAssemblyCount -ne 1 -or
+        $taskReceipt.pointerSize -ne 8 -or $taskReceipt.workerEdition -cne 'Desktop' -or
+        $taskReceipt.workerVersion -isnot [string] -or $taskReceipt.workerVersion -notmatch '^5\.1\.\d+\.\d+$' -or
+        $taskReceipt.bytes -le 0 -or $taskReceipt.bytes -gt 67108864) { throw 'R0 native PS5 metadata-only contract differs.' }
+    foreach ($taskField in @('path','name','assemblyVersion')) {
+        if ($taskReceipt.$taskField -isnot [string] -or $taskReceipt.$taskField -cne $Expected.$taskField) { throw ('R0 metadata identity differs: '+$taskField) }
+    }
+    if ($taskReceipt.sha256Before -cne $Expected.sha256 -or $taskReceipt.sha256After -cne $Expected.sha256 -or
+        $taskReceipt.bytes -ne (Get-Item -LiteralPath $Expected.path).Length -or (Get-Sha256 $Expected.path) -cne $Expected.sha256) { throw 'R0 prepared-file/hash/metadata join failed.' }
+    return $taskReceipt
+}
+
+function Initialize-RobotAssemblyIdentities([string[]]$Paths, [string]$Runtime) {
+    $taskRequiredCount=if ($CaseId -ceq 'F34-MIXED-CUT') { 11 } elseif ($CaseId -in $script:taskAf1Cases -or $CaseId -in @('REFUEL-G1','RIMMS-DLV1','F34-MIXED-CUT','F43-WORKSCAN')) { 10 } else { 12 }
+    if ([IntPtr]::Size -ne 8 -or $Paths.Count -ne $taskRequiredCount) { throw 'Native metadata preparation requires x64 and its exact closed assembly count (AF1/G1 ten; robots twelve).' }
+    $taskMetadataRoot=Join-Path $script:taskRun 'prepared-assembly-metadata'
+    Assert-ChildPath $taskMetadataRoot $script:taskRun
+    Assert-NoReparsePath $taskMetadataRoot
+    if (Test-Path -LiteralPath $taskMetadataRoot) { throw 'Preserve existing metadata preparation; no retry/overwrite.' }
+    New-Item -ItemType Directory -Path $taskMetadataRoot | Out-Null
+    $taskReaderSource=Join-Path $PSScriptRoot 'runtime-robot-pe-reader.ps1'
+    $taskReaderHash='E87103D411BB7F4811498E912A76991455C91D107AEE090D896897E0F349CD19'
+    if ((Get-Sha256 $taskReaderSource) -cne $taskReaderHash) { throw 'Exact R0 metadata reader source differs.' }
+    $taskReader=Join-Path $taskMetadataRoot 'runtime-robot-pe-reader.ps1'
+    [IO.File]::Copy($taskReaderSource,$taskReader,$false)
+    if ((Get-Sha256 $taskReader) -cne $taskReaderHash) { throw 'Copied R0 metadata reader differs.' }
+    $taskInterpreter=Join-Path ([Environment]::GetFolderPath([Environment+SpecialFolder]::System)) 'WindowsPowerShell\v1.0\powershell.exe'
+    Assert-NoReparsePath $taskInterpreter
+    $taskInterpreterHash=Get-Sha256 $taskInterpreter
+    $taskAssemblies=New-Object 'System.Collections.Generic.List[object]'
+    $taskReceipts=New-Object 'System.Collections.Generic.List[object]'
+    $taskNames=New-Object 'System.Collections.Generic.HashSet[string]' ([StringComparer]::Ordinal)
+    foreach ($taskPath in $Paths) {
+        $taskPath=Get-CanonicalPath $taskPath
+        Assert-ChildPath $taskPath $Runtime
+        $taskExpected=Get-AssemblyIdentity $taskPath
+        if (-not $taskNames.Add($taskExpected.name)) { throw 'Duplicate prepared R0 assembly identity.' }
+        $taskReceiptPath=Join-Path $taskMetadataRoot ($taskAssemblies.Count.ToString('D2')+'.json')
+        if ($taskPath.Length -gt 2048 -or $taskReceiptPath.Length -gt 2048 -or $taskReader.Length -gt 2048) { throw 'R0 metadata path exceeds bounded worker contract.' }
+        # Only fixed script text and Base64 payloads enter EncodedCommand, never raw path interpolation.
+        $taskReader64=[Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes($taskReader))
+        $taskInput64=[Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes($taskPath))
+        $taskOutput64=[Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes($taskReceiptPath))
+        $taskCode="& ([Text.Encoding]::UTF8.GetString([Convert]::FromBase64String('$taskReader64'))) -InputBase64 '$taskInput64' -OutputBase64 '$taskOutput64'"
+        $taskStart=New-Object Diagnostics.ProcessStartInfo
+        $taskStart.FileName=$taskInterpreter
+        $taskStart.Arguments='-NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -EncodedCommand '+[Convert]::ToBase64String([Text.Encoding]::Unicode.GetBytes($taskCode))
+        $taskStart.UseShellExecute=$false; $taskStart.CreateNoWindow=$true; $taskStart.WindowStyle=[Diagnostics.ProcessWindowStyle]::Hidden
+        $taskStart.WorkingDirectory=$taskMetadataRoot
+        $taskReaderProcess=New-Object Diagnostics.Process
+        $taskReaderProcess.StartInfo=$taskStart
+        $taskReaderStarted=$false
+        try {
+            if (-not $taskReaderProcess.Start()) { throw 'R0 metadata worker did not start.' }
+            $taskReaderStarted=$true
+            Write-NewJson (Join-Path $taskMetadataRoot ($taskAssemblies.Count.ToString('D2')+'-launch.json')) ([pscustomobject]@{
+                processId=$taskReaderProcess.Id; startedUtc=$taskReaderProcess.StartTime.ToUniversalTime().ToString('O');
+                interpreter=$taskInterpreter; interpreterSha256=$taskInterpreterHash; reader=$taskReader; readerSha256=$taskReaderHash;
+                input=$taskPath; expectedSha256=$taskExpected.sha256; output=$taskReceiptPath })
+            if (-not $taskReaderProcess.WaitForExit(30000)) {
+                # Only this controller-created metadata child; no enumeration or game process termination.
+                $taskReaderProcess.Kill()
+                if (-not $taskReaderProcess.WaitForExit(5000)) { throw 'R0 metadata child termination unconfirmed; do not proceed.' }
+                throw 'R0 metadata worker exceeded30seconds; preserve preparation and any partial receipt.'
+            }
+            if ($taskReaderProcess.ExitCode -ne 0) { throw 'R0 metadata worker failed; preserve complete/partial receipt.' }
+        }
+        finally {
+            try {
+                if ($taskReaderStarted -and -not $taskReaderProcess.HasExited) {
+                    $taskReaderProcess.Kill()
+                    if (-not $taskReaderProcess.WaitForExit(5000)) { throw ('R0 owned metadata child cleanup unconfirmed, PID='+$taskReaderProcess.Id) }
+                }
+            }
+            finally { $taskReaderProcess.Dispose() }
+        }
+        if ((Get-Sha256 $taskReader) -cne $taskReaderHash -or (Get-Sha256 $taskReaderSource) -cne $taskReaderHash -or
+            (Get-Sha256 $taskInterpreter) -cne $taskInterpreterHash) { throw 'R0 reader/interpreter changed during preparation.' }
+        $taskReceipt=Read-RobotMetadataReceipt $taskReceiptPath $taskExpected
+        $taskExpected | Add-Member -NotePropertyName moduleVersionId -NotePropertyValue $taskReceipt.moduleVersionId
+        $taskAssemblies.Add($taskExpected)
+        $taskReceipts.Add([pscustomobject]@{path=$taskReceiptPath; sha256=Get-Sha256 $taskReceiptPath; assemblyName=$taskExpected.name})
+    }
+    return [pscustomobject]@{assemblies=@($taskAssemblies.ToArray()); provenance=[pscustomobject]@{
+        reader=[pscustomobject]@{path=$taskReader; sha256=$taskReaderHash}; interpreter=[pscustomobject]@{path=$taskInterpreter; sha256=$taskInterpreterHash}; receipts=@($taskReceipts.ToArray())}}
+}
+
+function Assert-RobotPreparedMetadata($Manifest) {
+    if (-not $Manifest.PSObject.Properties['robotMetadata']) { throw 'R0 preparation lacks native file metadata proof; preserve and prepare a corrected new run.' }
+    $taskProof=$Manifest.robotMetadata
+    if ($null -eq $taskProof -or -not $taskProof.PSObject.Properties['reader'] -or -not $taskProof.PSObject.Properties['interpreter'] -or -not $taskProof.PSObject.Properties['receipts']) { throw 'R0 metadata provenance shape invalid.' }
+    $taskMetadataRoot=Join-Path $Manifest.runDirectory 'prepared-assembly-metadata'
+    if ($taskProof.reader.path -cne (Join-Path $taskMetadataRoot 'runtime-robot-pe-reader.ps1') -or $taskProof.reader.sha256 -cne 'E87103D411BB7F4811498E912A76991455C91D107AEE090D896897E0F349CD19' -or
+        (Get-Sha256 $taskProof.reader.path) -cne $taskProof.reader.sha256) { throw 'R0 prepared reader proof differs.' }
+    $taskInterpreter=Join-Path ([Environment]::GetFolderPath([Environment+SpecialFolder]::System)) 'WindowsPowerShell\v1.0\powershell.exe'
+    if ($taskProof.interpreter.path -cne $taskInterpreter -or (Get-Sha256 $taskInterpreter) -cne $taskProof.interpreter.sha256) { throw 'R0 metadata interpreter proof differs.' }
+    $taskExpectedNames=@('Assembly-CSharp','UnityEngine.CoreModule','0Harmony','HarmonyMod','HaulersDream','HaulersDream.Core','HaulersDream.RuntimeHarness','UnityEngine.IMGUIModule','UnityEngine.ScreenCaptureModule','UnityEngine.TextRenderingModule','AIRobot','MiscRobotsPlusPlus')
+    if ($Manifest.caseId -in $script:taskAf1Cases -or $Manifest.caseId -in @('REFUEL-G1','RIMMS-DLV1','F43-WORKSCAN')) { $taskExpectedNames=$taskExpectedNames[0..9] }
+    if ($Manifest.caseId -ceq 'F34-MIXED-CUT') { $taskExpectedNames=@($taskExpectedNames[0..9])+@('HaulersDream.F34Native') }
+    if (@($Manifest.expectedAssemblies).Count -ne $taskExpectedNames.Count -or @($taskProof.receipts).Count -ne $taskExpectedNames.Count) { throw 'Native metadata assembly/receipt census differs.' }
+    for ($taskIndex=0; $taskIndex -lt $taskExpectedNames.Count; $taskIndex++) {
+        $taskExpected=$Manifest.expectedAssemblies[$taskIndex]
+        $taskReceipt=$taskProof.receipts[$taskIndex]
+        if ($taskExpected.name -cne $taskExpectedNames[$taskIndex] -or -not $taskExpected.PSObject.Properties['moduleVersionId'] -or
+            $taskReceipt.assemblyName -cne $taskExpected.name -or $taskReceipt.path -cne (Join-Path $taskMetadataRoot ($taskIndex.ToString('D2')+'.json')) -or
+            (Get-Sha256 $taskReceipt.path) -cne $taskReceipt.sha256) { throw 'R0 prepared metadata receipt identity differs.' }
+        Assert-ChildPath $taskExpected.path $Manifest.runtimeDirectory
+        $taskRaw=Read-RobotMetadataReceipt $taskReceipt.path $taskExpected
+        if ($taskExpected.moduleVersionId -isnot [string] -or $taskExpected.moduleVersionId -cne $taskRaw.moduleVersionId) { throw 'R0 prepared MVID does not join the original file metadata receipt.' }
+    }
+}
+
+function Test-RobotResultMvids($Result, $Manifest, $Problems) {
+    foreach ($taskExpected in $Manifest.expectedAssemblies) {
+        $taskActual=@($Result.assemblies | Where-Object { $_.name -ceq $taskExpected.name })
+        if ($taskActual.Count -ne 1 -or $taskActual[0].moduleVersionId -cne $taskExpected.moduleVersionId) { $Problems.Add('R0 runtime MVID differs from prepared file metadata: '+$taskExpected.name) }
+    }
+}
+function Assert-RobotAutomaticFields($Value, [hashtable]$Fields, [string]$Location) {
+    if ($null -eq $Value -or $Value.GetType() -ne [System.Management.Automation.PSCustomObject]) { throw ('R1 JSON object required: '+$Location) }
+    foreach ($taskR1Name in $Fields.Keys) {
+        $taskR1Property=$Value.PSObject.Properties[$taskR1Name]
+        if ($null -eq $taskR1Property) { throw ('R1 required JSON field missing: '+$Location+'.'+$taskR1Name) }
+        $taskR1Value=$taskR1Property.Value
+        $taskR1Valid=$false
+        switch ($Fields[$taskR1Name]) {
+            'string' { $taskR1Valid=$taskR1Value -is [string] -and -not [string]::IsNullOrWhiteSpace($taskR1Value) }
+            'integer' { $taskR1Valid=$taskR1Value -is [int] -or $taskR1Value -is [long] }
+            'object' { $taskR1Valid=$null -ne $taskR1Value -and $taskR1Value.GetType() -eq [System.Management.Automation.PSCustomObject] }
+            'array' { $taskR1Valid=$taskR1Value -is [Array] }
+            default { throw 'Unknown R1 internal JSON field rule.' }
+        }
+        if (-not $taskR1Valid) { throw ('R1 JSON field type differs: '+$Location+'.'+$taskR1Name+'; required '+$Fields[$taskR1Name]) }
+    }
+}
+
+function Assert-RobotAutomaticProfileFields($Profile) {
+    Assert-RobotAutomaticFields $Profile @{schemaVersion='integer';caseId='string';status='string';content='object';harness='object'} 'profile'
+    Assert-RobotAutomaticFields $Profile.content @{root='string';manifestPath='string';manifestSha256='string';hdSha256='string';coreSha256='string'} 'profile.content'
+    Assert-RobotAutomaticFields $Profile.harness @{path='string';sha256='string';assemblyVersion='string';moduleVersionId='string';pdbPath='string';pdbSha256='string';sourceManifestPath='string';sourceManifestSha256='string';reviewReceiptPath='string';reviewReceiptSha256='string'} 'profile.harness'
+    foreach ($taskR1Hash in @($Profile.content.manifestSha256,$Profile.content.hdSha256,$Profile.content.coreSha256,$Profile.harness.sha256,$Profile.harness.pdbSha256,$Profile.harness.sourceManifestSha256,$Profile.harness.reviewReceiptSha256)) {
+        if ($taskR1Hash -cnotmatch '^[0-9A-F]{64}$') { throw 'R1 authoritative SHA must be an uppercase64-hex scalar string.' }
+    }
+    $taskR1Guid=[guid]::Empty
+    if ($Profile.harness.assemblyVersion -cne '0.1.0.0' -or -not [guid]::TryParseExact($Profile.harness.moduleVersionId,'D',[ref]$taskR1Guid) -or $taskR1Guid -eq [guid]::Empty -or $Profile.harness.moduleVersionId -cne $taskR1Guid.ToString('D')) { throw 'R1 profile actual version/canonical MVID differs.' }
+}
+
+function Read-RobotAutomaticProfileSnapshot([string]$Path) {
+    $taskR1Path=Get-CanonicalPath $Path
+    Assert-NoReparsePath $taskR1Path
+    $taskR1Stream=$null
+    try {
+        # One bounded byte snapshot is both parsed and hashed. FileShare.Read excludes a concurrent writer on this handle.
+        $taskR1Stream=[IO.File]::Open($taskR1Path,[IO.FileMode]::Open,[IO.FileAccess]::Read,[IO.FileShare]::Read)
+        $taskR1Length=$taskR1Stream.Length
+        if ($taskR1Length -le 0 -or $taskR1Length -gt 65536) { throw 'R1 profile type/size invalid.' }
+        $taskR1Bytes=New-Object byte[] ([int]$taskR1Length)
+        $taskR1Offset=0
+        while ($taskR1Offset -lt $taskR1Bytes.Length) {
+            $taskR1Read=$taskR1Stream.Read($taskR1Bytes,$taskR1Offset,$taskR1Bytes.Length-$taskR1Offset)
+            if ($taskR1Read -le 0) { throw 'R1 profile snapshot ended before its admitted length.' }
+            $taskR1Offset+=$taskR1Read
+        }
+        if ($taskR1Stream.ReadByte() -ne -1 -or $taskR1Stream.Length -ne $taskR1Length) { throw 'R1 profile snapshot length changed.' }
+    }
+    finally { if ($null -ne $taskR1Stream) { $taskR1Stream.Dispose() } }
+    $taskR1Sha=[Security.Cryptography.SHA256]::Create()
+    try { $taskR1Hash=[BitConverter]::ToString($taskR1Sha.ComputeHash($taskR1Bytes)).Replace('-','') }
+    finally { $taskR1Sha.Dispose() }
+    return [pscustomobject]@{path=$taskR1Path;bytes=$taskR1Length;sha256=$taskR1Hash;data=$taskR1Bytes}
+}
+
+function Assert-RobotAutomaticProfileReceipt([string]$Path, $Admission, [string]$Boundary) {
+    Assert-RobotAutomaticFields $Admission @{path='string';bytes='integer';sha256='string'} 'profile admission'
+    if ($Admission.bytes -le 0 -or $Admission.bytes -gt 65536 -or $Admission.sha256 -cnotmatch '^[0-9A-F]{64}$') { throw 'R1 admitted profile receipt is invalid.' }
+    $taskR1Snapshot=Read-RobotAutomaticProfileSnapshot $Path
+    if ($taskR1Snapshot.bytes -ne $Admission.bytes -or $taskR1Snapshot.sha256 -cne $Admission.sha256) {
+        throw ('R1 profile changed from its original admitted bytes at '+$Boundary+'. Preserve this preparation; do not re-admit the replacement.')
+    }
+}
+
+function Read-RobotAutomaticProfile([string]$Path, [string]$SelectedContent, [string]$SelectedHarness) {
+    $taskR1Snapshot=Read-RobotAutomaticProfileSnapshot $Path
+    $taskR1Encoding=New-Object Text.UTF8Encoding($false,$true)
+    $taskR1Text=$taskR1Encoding.GetString($taskR1Snapshot.data)
+    if ($taskR1Text.Length -gt 0 -and $taskR1Text[0] -eq [char]0xFEFF) { $taskR1Text=$taskR1Text.Substring(1) }
+    if (-not $taskR1Text.TrimStart().StartsWith('{',[StringComparison]::Ordinal)) { throw 'R1 profile JSON root must be an object; root-array pipeline unwrapping is not accepted.' }
+    $taskR1=$taskR1Text | ConvertFrom-Json
+    Assert-RobotAutomaticFields $taskR1 @{schemaVersion='integer';caseId='string';status='string'} 'profile'
+    if ($taskR1.schemaVersion -ne 1 -or $taskR1.caseId -cne 'ROBOTS-R1-AUTO' -or $taskR1.status -cne 'bound-reviewed') {
+        throw 'R1 profile is intentionally non-executable until root binds and reviews the actual compiled harness. No placeholder may be inferred.'
+    }
+    Assert-RobotAutomaticProfileFields $taskR1
+    foreach ($taskR1Hash in @($taskR1.harness.sha256,$taskR1.harness.pdbSha256,$taskR1.harness.sourceManifestSha256,$taskR1.harness.reviewReceiptSha256)) {
+        if ($taskR1Hash -cnotmatch '^[0-9A-F]{64}$') { throw 'R1 bound harness/source/PDB/review hashes required.' }
+    }
+    $taskR1Guid=[guid]::Empty
+    if (-not [guid]::TryParseExact($taskR1.harness.moduleVersionId,'D',[ref]$taskR1Guid) -or $taskR1Guid -eq [guid]::Empty -or $taskR1.harness.moduleVersionId -cne $taskR1Guid.ToString('D')) { throw 'R1 actual canonical harness MVID required.' }
+    if ($taskR1.harness.assemblyVersion -cne '0.1.0.0' -or (Get-CanonicalPath $SelectedHarness) -cne (Get-CanonicalPath $taskR1.harness.path) -or
