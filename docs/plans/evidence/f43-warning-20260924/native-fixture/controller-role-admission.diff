-    if ([string]::IsNullOrWhiteSpace($Path) -or -not [IO.Path]::IsPathRooted($Path) -or $Path.Contains('=') -or $Path.Contains('"')) {
-        throw "Expected an absolute path without '=' or quotes: $Path"
-    }
-    return [IO.Path]::GetFullPath($Path).TrimEnd('\', '/')
-}
