+using Verse.AI;
+
+namespace HaulersDream.RuntimeHarness
+{
+    internal sealed partial class F12Scene : IDisposable
+    {
+        private readonly Map map;
+        private readonly string role,evidence,run;
+        private readonly Action<string,bool,string> check;
+        private readonly Action<string,string> emit;
+        private readonly System.Diagnostics.Stopwatch clock=System.Diagnostics.Stopwatch.StartNew();
+        private readonly List<Tuple<Pawn,IntVec3,Rot4>> parked=new List<Tuple<Pawn,IntVec3,Rot4>>();
+        private readonly Dictionary<FieldInfo,object> settings=new Dictionary<FieldInfo,object>();
+        private readonly TimeSpeed oldSpeed;
+        private readonly float oldMean,oldScale;
+        private readonly LoadedLanguage oldLanguage;
+        private F12UiObservers observers;
+        private Pawn actor,other;
+        private Thing sentinel,source,unrelated;
+        private Zone_Stockpile storage;
+        private CellRect arena;
+        private IntVec3 origin,destination,invalidWall,invalidShelf,invalidResident,invalidReserved,invalidUnreachable;
+        private int startTick,warmupTick,lastTemperatureTick=-1;
+        private double warmupWall;
+        private bool disposed;
+        private string status="running",stage="setup";
+        internal Pawn Actor=>actor;
+        internal bool LoadedBeforeTick=>false;
+        internal void Emit(string name,string text)=>emit(name,text);
+        internal F12Scene(Map map,string role,string evidence,Action<string,bool,string> check,Action<string,string> emit,bool load=false)
+        {
+            this.map=map;this.role=role;this.evidence=evidence;this.check=check;this.emit=emit;
+            run=Path.GetDirectoryName(Path.GetFullPath(evidence));startTick=Find.TickManager.TicksGame;
+            oldSpeed=Find.TickManager.CurTimeSpeed;oldMean=map.TileInfo.temperature;oldScale=Prefs.UIScale;oldLanguage=LanguageDatabase.activeLanguage;
+            try { Guard(!load,"F12 UI has no restart role.");Custody(false);observers=new F12UiObservers(this);Setup(); }
+            catch(Exception e){Fault(e);}
+        }
+        private void Custody(bool load)
+        {
+            string manifest,actual;Guid id;
+            Guard(GenCommandLine.TryGetCommandLineArg("hd-harnessmanifest",out manifest)&&GenCommandLine.TryGetCommandLineArg("hd-test",out actual)
+                &&actual==role&&Same(Path.GetDirectoryName(manifest),run)&&Same(evidence,Path.Combine(run,"evidence"))
+                &&Guid.TryParseExact(Path.GetFileName(run),"N",out id)&&id!=Guid.Empty
+                &&Same(Path.GetDirectoryName(run),Path.Combine(Path.GetTempPath(),"haulersdream-runtime-tests"))
+                &&Child(GenFilePaths.SaveDataFolderPath,run)&&Child(typeof(F12Scene).Assembly.Location,Path.Combine(run,"runtime")),"Exact private F12 run/save/assembly custody required.");
+            Guard(UnityData.IsInMainThread&&Current.Game!=null&&map.IsPlayerHome&&map==Find.CurrentMap
+                &&(load?!GenCommandLine.CommandLineArgPassed("quicktest"):GenCommandLine.CommandLineArgPassed("quicktest")),"Actual private map/role differs.");
+            Find.TickManager.CurTimeSpeed=TimeSpeed.Paused;
+            emit("f12-private-custody",F02Json.Stringify(new{role,run,evidence,temp=Path.GetTempPath(),save=GenFilePaths.SaveDataFolderPath,assembly=typeof(F12Scene).Assembly.Location,load}));
+        }
+        private void Setup()
+        {
+            Guard(role=="F12-UI","Producer role required.");
+            Set("masterEnabled",true);Set("markForUnload",false);Set("unloadAllSurplus",false);
+            ControlTemperature();
+            foreach(var p in map.mapPawns.AllPawnsSpawned.ToArray())
+            {parked.Add(Tuple.Create(p,p.Position,p.Rotation));if(p.lord!=null)p.lord.RemovePawn(p);p.DeSpawn();Find.WorldPawns.PassToWorld(p,PawnDiscardDecideMode.KeepForever);}
+            foreach(var t in map.listerThings.AllThings.Where(t=>t is Skyfaller||t is ActiveTransporter).ToArray())t.DeSpawn();
+            arena=new CellRect(map.Center.x-19,map.Center.z-12,39,25);
+            Guard(arena.Cells.All(c=>c.InBounds(map)&&map.zoneManager.ZoneAt(c)==null),"Fresh unzoned arena required.");
+            GenDebug.ClearArea(arena,map);
+            foreach(var c in arena.Cells)
+            {map.terrainGrid.SetTerrain(c,TerrainDefOf.Concrete);map.roofGrid.SetRoof(c,null);map.fogGrid.Unfog(c);map.areaManager.Home[c]=true;
+                if(c.x==arena.minX||c.x==arena.maxX||c.z==arena.minZ||c.z==arena.maxZ)GenSpawn.Spawn(ThingMaker.MakeThing(ThingDefOf.Wall,ThingDefOf.Steel),c,map);}
+            warmupTick=Find.TickManager.TicksGame;warmupWall=clock.Elapsed.TotalSeconds;Temperatures("unroofed-start",true);stage="warmup";
+            Find.TickManager.CurTimeSpeed=TimeSpeed.Superfast;
+        }
+        private void ControlTemperature()
+        {
+            Guard(map.Tile.Layer is SurfaceLayer&&!map.IsPocketMap&&!map.Biome.constantOutdoorTemperature.HasValue,"Native surface climate required.");
+            Guard(map.gameConditionManager.ActiveConditions.Concat(Find.World.gameConditionManager.ActiveConditions).All(c=>c.TemperatureOffset()==0),"External temperature offset present.");
+            var tc=Find.World.tileTemperatures;tc.ClearCaches();float min=float.MaxValue,max=float.MinValue;
+            for(int t=Find.TickManager.TicksAbs;t<=Find.TickManager.TicksAbs+24000;t++){float x=tc.OutdoorTemperatureAt(map.Tile,t);min=Math.Min(min,x);max=Math.Max(max,x);}
+            float mean=Mathf.Clamp(Mathf.RoundToInt((oldMean+20f-(min+max)/2f+300f)*10f),0,65535)/10f-300f;
+            Guard(min+mean-oldMean>=8.5f&&max+mean-oldMean<=29.5f,"Controlled forecast too wide.");map.TileInfo.temperature=mean;tc.ClearCaches();
+            emit("f12-controlled-temperature",F02Json.Stringify(new{original=oldMean,selected=mean,min=min+mean-oldMean,max=max+mean-oldMean,outdoor=map.mapTemperature.OutdoorTemp}));
+        }
