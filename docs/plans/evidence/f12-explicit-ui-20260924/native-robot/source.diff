+            Add("robot-setting/disable",()=>{Set("allowMechanoids",false);CaptureBoundary();},()=>observedSourceDisabled&&observedGizmoOwner==actor.thingIDNumber);
+            Click("robot-setting/actual-disabled-click","source-gizmo",()=>!Find.Targeter.IsTargeting&&!DialogOpen);
+            Add("robot-setting/unchanged",()=>Unchanged("robot-setting-disabled-actual-control"));
+            Add("robot-specialist/select",()=>{Set("allowMechanoids",true);Find.Selector.ClearSelection();Find.Selector.Select(specialist);CaptureBoundary();},()=>observedSourceDisabled&&observedGizmoOwner==specialist.thingIDNumber);
+            Click("robot-specialist/actual-disabled-click","source-gizmo",()=>!Find.Targeter.IsTargeting&&!DialogOpen);
+            Add("robot-specialist/unchanged",()=>{Unchanged("robot-specialist-disabled-actual-control");Require("specialist-native-role-unchanged",RobotRoles(specialist)==specialistRoles&&specialist.jobs.jobQueue.Count==0&&specialist.inventory.innerContainer.Count==0&&specialist.carryTracker.CarriedThing==null,"Actual BuilderIII roles="+specialistRoles);});
+            Add("robot-positive/select",()=>{Find.Selector.ClearSelection();Find.Selector.Select(actor);CaptureBoundary();},()=>!observedSourceDisabled&&observedGizmoOwner==actor.thingIDNumber);
