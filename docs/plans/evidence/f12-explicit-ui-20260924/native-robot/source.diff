+            var creator=assembly.GetType("AIRobot.X2_Building_AIRobotCreator",true).GetMethod("CreateRobot",BindingFlags.Public|BindingFlags.Static,null,new[]{typeof(string),typeof(IntVec3),typeof(Map),typeof(Faction)},null);
+            Guard(creator!=null,"Actual public robot factory missing.");Pawn p;Rand.PushState(120024+cell.x+cell.z);
+            try{p=(Pawn)creator.Invoke(null,new object[]{def,cell,map,Faction.OfPlayer});}finally{Rand.PopState();}
+            Guard(p!=null&&p.GetType().FullName=="AIRobot.X2_AIRobot"&&p.def.defName==def&&p.Spawned&&p.Map==map&&p.Faction==Faction.OfPlayer
+                &&p.AllComps.OfType<CompHauledToInventory>().Count()==1&&p.inventory!=null&&p.carryTracker!=null&&p.jobs!=null&&Fit(p),"Actual generated robot/component/health identity differs.");
+            Guard(p.inventory.innerContainer.Count==0&&p.carryTracker.CarriedThing==null,"Native robot must start without cargo.");
+            emit("f12-real-provider-robot",F02Json.Stringify(new{id=p.ThingID,def=p.def.defName,type=p.GetType().AssemblyQualifiedName,nativeCanTakeOrder=p.CanTakeOrder,roles=RobotRoles(p),hediffs=p.health.hediffSet.hediffs.Count,rest=p.needs.rest.CurLevel,comps=p.AllComps.Select(c=>c.GetType().FullName).ToArray()}));return p;
