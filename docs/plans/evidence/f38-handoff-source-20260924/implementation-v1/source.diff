+                for (int slot = 0; slot < 3; slot++)
+                {
+                    Assert.That(targets[slot], Is.EqualTo(slot == handedOff ? null : beforeTargets[slot]));
+                    Assert.That(counts[slot], Is.EqualTo(slot == handedOff ? 0 : beforeCounts[slot]));
