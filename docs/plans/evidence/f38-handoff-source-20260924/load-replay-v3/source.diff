+            else
+            {
+                expectedBoundaries=File.ReadAllLines(Path.Combine(run,"input/replay-boundaries.txt"));Guard(expectedBoundaries.Length==11,"Successful loaded reference must contain eleven boundaries.");
+                Record("fresh-consumers-exact-loaded-state",File.ReadAllText(Path.Combine(run,"input/loaded-precommand.txt"))==actual,"actual="+actual);
+                Record("fresh-consumers-exact-native-allocation",File.ReadAllText(Path.Combine(run,"input/load-allocation.txt"))==allocationReceipt,"actual count="+allocations.Count);
+            }
+            Guard(!failed,"Original saved state or native allocation admission failed.");
+        }
+
+        private static Dictionary<string,int> ReadCounters(string value)=>value.Split(',').Select(p=>p.Split(':'))
+            .ToDictionary(p=>p[0],p=>int.Parse(p[1],CultureInfo.InvariantCulture),StringComparer.Ordinal);
+    }
+}
