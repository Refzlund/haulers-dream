+            int aStart=actual.IndexOf(";ids=",StringComparison.Ordinal),aEnd=actual.IndexOf(";actors=",StringComparison.Ordinal);
+            Guard(eStart>=0&&eEnd>eStart&&aStart>=0&&aEnd>aStart,"Malformed saved/actual state receipt.");
+            var before=ReadCounters(expected.Substring(eStart+5,eEnd-eStart-5));
+            var after=ReadCounters(actual.Substring(aStart+5,aEnd-aStart-5));
+            bool savedFieldsExact=expected.Substring(0,eStart)==actual.Substring(0,aStart)&&expected.Substring(eEnd)==actual.Substring(aEnd)
+                &&before.Count==after.Count&&before.All(p=>after.ContainsKey(p.Key)&&(p.Key=="nextThingID"||after[p.Key]==p.Value));
+            Record("saved-state-and-other-counters-exact",savedFieldsExact&&ticks.TicksGame==savedTick&&map.uniqueID==Number("map")
+                &&F(map.TileInfo.temperature)==checkpoint["mean"],"expected="+expected+"; actual="+actual);
+
