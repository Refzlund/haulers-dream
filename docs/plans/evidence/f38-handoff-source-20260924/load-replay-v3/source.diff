+# F38 fresh-load comparison only. Functions inspect inputs; they never launch or mutate a run.
+function Read-F38ReplayReference([string]$Path, $Selection, [string]$SaveSha, [string]$RecordSha) {
+    $f38RefRun=Get-CanonicalPath $Path
+    Assert-ChildPath $f38RefRun $taskBase; Assert-NoReparsePath $f38RefRun
+    $f38RefId=[Guid]::Empty
+    if ((Split-Path -Parent $f38RefRun) -cne $taskBase -or -not [Guid]::TryParseExact((Split-Path -Leaf $f38RefRun),'N',[ref]$f38RefId)) { throw 'Reference must be one controller-owned native run.' }
+    $f38RefManifestPath=Join-Path $f38RefRun 'manifest.json'
+    $f38RefResultPath=Join-Path $f38RefRun 'evidence\result.json'
+    $f38RefManifest=Get-Content -LiteralPath $f38RefManifestPath -Encoding UTF8 -Raw | ConvertFrom-Json
+    $f38RefResult=Read-Dlv1CommonResult $f38RefResultPath
+    if ($f38RefManifest.runDirectory -cne $f38RefRun -or $f38RefManifest.runId -cne (Split-Path -Leaf $f38RefRun) -or
+        $f38RefManifest.caseId -cne 'F38-REPLAY' -or $f38RefManifest.expectedBehavior -cne 'satisfied' -or
+        $f38RefManifest.negativeControl -cne 'None' -or $f38RefManifest.restartCheckpoint.mode -cne 'record' -or
+        $f38RefManifest.restartCheckpoint.saveSha256 -cne $SaveSha -or $f38RefManifest.restartCheckpoint.recordSha256 -cne $RecordSha -or
+        $f38RefResult.runId -cne $f38RefManifest.runId -or $f38RefResult.caseId -cne 'F38-REPLAY' -or
+        $f38RefResult.status -cne 'passed' -or $f38RefResult.unityErrorsObserved -ne 0 -or
+        @($f38RefResult.assertions | Where-Object { -not $_.passed }).Count -ne 0) { throw 'Reference must be a successful first fresh consumer of the same original save.' }
+    foreach ($f38Id in @('f38/native-load-module-bound','f38/saved-state-and-other-counters-exact','f38/exact-native-compressed-allocation','f38/physical-150-7-25-8','f38/physical-stable-300','f38/complete-replay-boundaries')) {
+        if (-not (Test-RequiredAssertion $f38RefResult.assertions $f38Id $true)) { throw ('Reference lacks actual acceptance: '+$f38Id) }
+    }
+    if (@($f38RefManifest.expectedAssemblies).Count -ne 10 -or @($f38RefResult.assemblies).Count -ne 10) { throw 'Reference must bind ten actual images.' }
+    foreach ($f38Image in $f38RefManifest.expectedAssemblies) {
+        Assert-ChildPath $f38Image.path (Join-Path $f38RefRun 'runtime')
+        $f38Actual=@($f38RefResult.assemblies | Where-Object { $_.name -ceq $f38Image.name })
+        $f38Pinned=@(@($Selection.candidate.files)+@($Selection.harness)+@($Selection.providers) | Where-Object { (Split-Path -Leaf $_.path) -ceq ($f38Image.name+'.dll') -and $_.sha256 -ceq $f38Image.sha256 })
+        if ($f38Actual.Count -ne 1 -or $f38Pinned.Count -ne 1 -or (Get-Sha256 $f38Image.path) -cne $f38Image.sha256 -or
+            $f38Actual[0].path -cne $f38Image.path -or $f38Actual[0].sha256 -cne $f38Image.sha256 -or
+            $f38Actual[0].moduleVersionId -cne $f38Image.moduleVersionId -or $f38Actual[0].assemblyVersion -cne $f38Image.assemblyVersion) { throw ('Reference actual image differs: '+$f38Image.name) }
+    }
+    # Revalidate every original copied input and prepared config, not just the ten modules.
+    $f38RefFiles=@($f38RefManifest.copiedFiles)+@($f38RefManifest.configFiles)
+    if ($f38RefFiles.Count -lt 1000) { throw 'Reference copied-input census is incomplete.' }
+    foreach ($f38File in $f38RefFiles) {
+        Assert-ChildPath $f38File.path $f38RefRun; Assert-NoReparsePath $f38File.path
+        if ((Get-Sha256 $f38File.path) -cne $f38File.sha256) { throw ('Reference copied/config input differs: '+$f38File.path) }
+    }
+    $f38Records=@('replay-boundaries.txt','loaded-precommand.txt','load-allocation.txt') | ForEach-Object {
+        $f38Path=Join-Path $f38RefRun ('evidence\'+$_)
+        [pscustomobject]@{name=$_;sourcePath=$f38Path;sha256=(Get-Sha256 $f38Path)}
+    }
+    if (@([IO.File]::ReadAllLines($f38Records[0].sourcePath)).Count -ne 11 -or @([IO.File]::ReadAllLines($f38Records[2].sourcePath)).Count -ne 3184) { throw 'Reference command/allocation receipt is incomplete.' }
+    return [pscustomobject]@{
+        run=$f38RefRun; records=@($f38Records); manifestPath=$f38RefManifestPath; resultPath=$f38RefResultPath
+        protectedRoots=@($f38RefManifestPath,$f38RefResultPath,(Join-Path $f38RefRun 'evidence\events.jsonl'),(Join-Path $f38RefRun 'evidence\Player.log'))+
+            @($f38Records | ForEach-Object { $_.sourcePath })+@($f38RefFiles | ForEach-Object { $_.path })+
+            @($f38RefManifest.robotMetadata.receipts | ForEach-Object { $_.path })
+    }
+}
+
+function Assert-F38CopiedReplay($Manifest) {
+    $f38Proof=$Manifest.restartCheckpoint
+    if ($f38Proof.mode -cnotin @('record','compare') -or $f38Proof.saveSha256 -cne 'E10F40C2418349AF3D7A46E108A2E31F2FB4B437590DFBE17A58193C08AA15CD' -or
+        $f38Proof.recordSha256 -cne '2B68F85CA73838AC1442D03C4CABDA47F2DF84C34608EA84E510D712C40C70F9' -or
+        $f38Proof.savePath -cne (Join-Path $Manifest.saveDataDirectory 'Saves\Autostart.rws') -or
+        $f38Proof.recordPath -cne (Join-Path $Manifest.runDirectory 'input\checkpoint.txt') -or
+        (Get-Sha256 $f38Proof.savePath) -cne $f38Proof.saveSha256 -or (Get-Sha256 $f38Proof.recordPath) -cne $f38Proof.recordSha256) { throw 'Original F38 copied checkpoint differs.' }
+    if ($f38Proof.mode -ceq 'record') {
+        if ($null -ne $f38Proof.reference -or (Test-Path -LiteralPath (Join-Path $Manifest.runDirectory 'input\replay-boundaries.txt'))) { throw 'First fresh consumer cannot use no-load producer boundaries.' }
+    } else {
+        $f38Required=@('replay-boundaries.txt','loaded-precommand.txt','load-allocation.txt')
+        if (@($f38Proof.reference.records).Count -ne 3) { throw 'Comparison requires three reference receipts.' }
+        foreach ($f38Name in $f38Required) {
+            $f38Rows=@($f38Proof.reference.records | Where-Object { $_.name -ceq $f38Name })
+            if ($f38Rows.Count -ne 1 -or $f38Rows[0].path -cne (Join-Path $Manifest.runDirectory ('input\'+$f38Name)) -or
+                (Get-Sha256 $f38Rows[0].path) -cne $f38Rows[0].sha256) { throw ('Copied fresh-consumer receipt differs: '+$f38Name) }
+        }
+    }
+}
