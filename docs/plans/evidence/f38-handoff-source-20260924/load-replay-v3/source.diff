+            var maps=xml.SelectNodes("/savegame/game/maps/li");Guard(maps.Count==1&&map.Size.x==250&&map.Size.z==250,"Exactly the original 250x250 map required.");
+            var compressed=maps[0].SelectSingleNode("compressedThingMapDeflate");Guard(compressed!=null,"Original native compressed map required.");
