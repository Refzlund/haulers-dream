+using System;
+using System.Collections.Generic;
+using System.Diagnostics;
+using System.IO;
+using System.Linq;
+using HarmonyLib;
+using RimWorld;
+using Verse;
+
+namespace HaulersDream.F38Capacity
+{
+    public sealed partial class CapacityReplay
+    {
+        private readonly List<string> nativeTicks=new List<string>();
+        private readonly List<string> nativeAllocations=new List<string>();
+        private bool nativeWindowFinished;
+        private int nativeScopeDepth;
+
+        private sealed class NativeTickScope
+        {
+            public CapacityReplay Owner;
+            public ulong Outside,Input;
+            public int Tick,Seed,Depth;
+            public string Counters;
+            public bool Pushed;
+        }
+
+        private bool NativeWindow=>restart&&!cleaned&&status=="running"&&!nativeWindowFinished;
+
+        private void ObserveNativeTicks()
+        {
+            // This wraps actual engine ticks; it never invokes or substitutes a tick.
+            observer.Patch(AccessTools.Method(typeof(TickManager),"DoSingleTick"),
+                prefix:new HarmonyMethod(typeof(CapacityReplay),nameof(NativeTickEntering)),
+                finalizer:new HarmonyMethod(typeof(CapacityReplay),nameof(NativeTickLeaving)));
+            Patch(typeof(ThingIDMaker),"GiveIDTo",nameof(NativeThingAllocated),false);
+            Patch(typeof(UniqueIDsManager),"GetNextLogID",nameof(NativeLogAllocated),false);
+        }
+
+        private static void NativeTickEntering(ref NativeTickScope __state)
+        {
+            var c=current;if(c==null||!c.NativeWindow)return;
+            // Identical explicit RNG input for each real native tick in this bounded
+            // command replay. Preserve the process RNG, including nested native calls.
+            __state=new NativeTickScope{Owner=c,Outside=Rng(),Tick=c.ticks.TicksGame+1,
+                Depth=c.nativeScopeDepth,Counters=c.UniqueIds()};
+            __state.Seed=unchecked(424380+__state.Tick*7919+__state.Depth*101);
+            Rand.PushState(__state.Seed);__state.Pushed=true;c.nativeScopeDepth++;__state.Input=Rng();
+            try
+            {
+                Guard(__state.Input==(ulong)(uint)__state.Seed,"Native RNG input differs from the explicit seed.");
+                Guard(c.nativeTicks.Count<35000,"Native replay tick receipt limit reached.");
+                c.emit("f38-native-tick-input","tick="+__state.Tick+"; depth="+__state.Depth+"; seed="+__state.Seed+"; input="+__state.Input+"; outside="+__state.Outside);
+            }
+            catch(Exception ex){c.observerError=ex.ToString();}
+        }
+
+        private static Exception NativeTickLeaving(Exception __exception,NativeTickScope __state)
+        {
+            if(__state==null||!__state.Pushed)return __exception;
+            var c=__state.Owner;ulong inside=Rng();
+            // Pop also on a native exception or a failed observation. Never suppress
+            // the native exception, write IDs, or replace a native method result.
+            try{Rand.PopState();}
+            finally{__state.Pushed=false;c.nativeScopeDepth--;}
+            try
+            {
+                Guard(Rng()==__state.Outside&&c.nativeScopeDepth==__state.Depth,"Native tick RNG scope did not restore its exact enclosing state.");
+                string line="tick="+__state.Tick+"; depth="+__state.Depth+"; seed="+__state.Seed+"; input="+__state.Input+"; output="+inside
+                    +"; before="+__state.Counters+"; after="+c.UniqueIds()+"; exception="+(__exception?.GetType().FullName??"none");
+                c.nativeTicks.Add(line);File.AppendAllText(Path.Combine(c.evidence,"native-tick-rng.txt"),line+"\n");
+                c.emit("f38-native-tick-output",line+"; outside-restored="+Rng());
+            }
+            catch(Exception ex){c.observerError=ex.ToString();}
+            return __exception;
+        }
+
+        private static void NativeThingAllocated(Thing __0)
+        {
+            Watch(c=>{if(c.NativeWindow&&__0?.def.HasThingIDNumber==true)c.Allocation("thing="+__0.ThingID+"; def="+__0.def.defName);});
+        }
+        private static void NativeLogAllocated(int __result)
+        {
+            Watch(c=>{if(c.NativeWindow)c.Allocation("log="+__result);});
+        }
+        private void Allocation(string identity)
+        {
+            Guard(nativeAllocations.Count<1000,"Native replay allocation receipt limit reached.");
+            var native=typeof(Map).Assembly;var product=typeof(HaulersDreamMod).Assembly;
+            string callers=string.Join(" > ",new StackTrace(false).GetFrames().Select(f=>f.GetMethod())
+                .Where(m=>m?.DeclaringType!=null&&(m.DeclaringType.Assembly==native||m.DeclaringType.Assembly==product))
+                .Take(12).Select(m=>m.DeclaringType.FullName+"."+m.Name));
+            string line="tick="+ticks.TicksGame+"; depth="+nativeScopeDepth+"; "+identity+"; callers="+callers;
+            nativeAllocations.Add(line);File.AppendAllText(Path.Combine(evidence,"native-tick-allocations.txt"),line+"\n");
+            emit("f38-native-allocation",line+"; rng="+Rng());
+        }
+
+        private void FinishNativeTickWindow()
+        {
+            Guard(nativeScopeDepth==0&&boundaries.Count==11,"Replay window must close outside a tick after all eleven original boundaries.");
+            nativeWindowFinished=true;
+            string tickText=string.Join("\n",nativeTicks)+"\n";
+            string allocationText=string.Join("\n",nativeAllocations)+(nativeAllocations.Count>0?"\n":"");
+            // Ensure even an empty allocation receipt exists. Preserve incremental
+            // receipts on an earlier failure; do not emit synthesized replacement data.
+            File.WriteAllText(Path.Combine(evidence,"native-tick-allocations.txt"),allocationText);
+            Record("native-tick-rng-window",nativeTicks.Count==keepTick+1-savedTick&&nativeTicks.Count>0
+                &&(recordReplay||File.ReadAllText(Path.Combine(run,"input/native-tick-rng.txt"))==tickText),
+                "actual ticks="+nativeTicks.Count+"; start="+(savedTick+1)+"; end="+ticks.TicksGame+"; complete input/output/counter receipts exact="+(!recordReplay));
+            Record("native-allocation-window",recordReplay||File.ReadAllText(Path.Combine(run,"input/native-tick-allocations.txt"))==allocationText,
+                "actual native allocations="+nativeAllocations.Count+"; no identity/counter writes; record role="+recordReplay);
+        }
+    }
+}
