+using System;
+using System.Collections.Generic;
+using System.Linq;
+using RimWorld;
+using Verse;
+
+namespace HaulersDream.PbMenuFixture
+{
+    // These are deliberately unknown to the product's action catalogue. The fixture identifies
+    // its own stimulus, but never registers it with HD or imitates a supported provider contract.
+    internal sealed class UnknownContribution
+    {
+        internal Bill_Production Bill;
+        internal readonly BillRepeatModeDef Mode = new BillRepeatModeDef { defName = "F45_UnknownFixtureMode", label = "F45 unknown contribution" };
+        internal int ModeCalls, SettingsCalls;
+        internal void SelectMode() { ModeCalls++; Bill.repeatMode = Mode; }
+        internal void Settings() { SettingsCalls++; }
+    }
+
+    internal sealed partial class PbMenuScenario
+    {
+        private Bill_Production multiIngredient;
+        private UnknownContribution unknown;
+        private FloatMenuOption unknownModeOption, unknownSettingsOption;
+
+        private static string[] SharedModes(Profile p)
+        {
+            var modes = new List<string> { "RepeatCount", "Forever", "TargetCount" };
+            if (p.Ego) modes.AddRange(new[] { "TD_PersonCount", "TD_XPerPerson", "TD_WithSurplusIng" });
+            if (p.Cl) modes.Add("W_PerTag");
+            if (p.It) modes.Add("IngredientThreshold");
+            if (p.Pb) modes.Add("PB_Periodic");
+            return modes.ToArray();
+        }
+        private static string[] SharedRoster(Profile p)
+        {
+            var cells = new List<string> { "shared-prime", "shared-cancel" };
+            cells.AddRange(SharedModes(p).Select(x => "shared-select-" + x));
+            cells.Add("shared-reject-target");
+            if (p.Ego) cells.AddRange(new[] { "shared-reject-person", "shared-reject-x-person", "shared-reject-surplus" });
+            if (p.Cl) cells.Add("shared-reject-loadouts");
+            cells.AddRange(new[] { "shared-unknown-settings", "shared-unknown-mode" });
+            return cells.ToArray();
+        }
+        private void RunShared(string id, Cell cell)
+        {
+            if (id == "shared-prime")
+            {
+                Bindings.Seed(simple, "RepeatCount", false);
+                RunOperation(cell, simple, id, null, null, "cancel"); Primed = true; return;
+            }
+            if (id == "shared-cancel")
+            { Bindings.Seed(simple, "RepeatCount", true); RunOperation(cell, simple, id, null, null, "cancel"); return; }
+            if (id.StartsWith("shared-select-", StringComparison.Ordinal))
+            {
+                string mode = id.Substring("shared-select-".Length);
+                Bindings.Seed(simple, "RepeatCount", true);
+                RunOperation(cell, simple, "batch-to-" + mode, "plain", mode, "accepted");
+                Bindings.Seed(simple, mode, true);
+                RunOperation(cell, simple, "same-" + mode, "plain", mode, "accepted");
+                return;
+            }
+            if (id.StartsWith("shared-reject-", StringComparison.Ordinal))
+            {
+                string mode; var bill = uncountable; string expected = "rejected";
+                switch (id)
+                {
+                    case "shared-reject-target": mode = "TargetCount"; if (Profile.Pb && Profile.PbFirst) expected = "disabled"; break;
+                    case "shared-reject-person": mode = "TD_PersonCount"; break;
+                    case "shared-reject-x-person": mode = "TD_XPerPerson"; break;
+                    case "shared-reject-surplus": mode = "TD_WithSurplusIng"; bill = multiIngredient; break;
+                    case "shared-reject-loadouts": mode = "W_PerTag"; break;
+                    default: throw new InvalidOperationException("Unknown shared rejection.");
+                }
+                Evidence.Require(bill != null, "Actual rejection recipe is absent.");
+                Bindings.Seed(bill, "RepeatCount", true); RunOperation(cell, bill, id, "plain", mode, expected); return;
+            }
+            if (id == "shared-unknown-settings" || id == "shared-unknown-mode")
+            {
+                Bindings.Seed(simple, "RepeatCount", true);
+                unknown = new UnknownContribution { Bill = simple };
+                unknownModeOption = new FloatMenuOption("F45 unknown contribution", unknown.SelectMode) { orderInPriority = 17 };
+                unknownSettingsOption = new FloatMenuOption("F45 unknown settings", unknown.Settings) { orderInPriority = 19 };
+                try
+                {
+                    bool selectMode = id == "shared-unknown-mode";
+                    RunOperation(cell, simple, id, selectMode ? "unknown-mode" : "unknown-settings", selectMode ? unknown.Mode.defName : null, selectMode ? "unknown-mode" : "unknown-settings");
+                    Evidence.Require(unknown.ModeCalls == (selectMode ? 1 : 0) && unknown.SettingsCalls == (selectMode ? 0 : 1), "Exact unknown body counts differ.");
+                    cell.checks.Add("PASS Unknown original option/action/presentation preserved, selected once; product catalogue was not taught its identity.");
+                }
+                finally { unknown = null; unknownModeOption = unknownSettingsOption = null; }
+                return;
+            }
+            throw new InvalidOperationException("Shared cell has no body: " + id);
+        }
+        internal void InjectUnknownContribution(List<FloatMenuOption> input)
+        {
