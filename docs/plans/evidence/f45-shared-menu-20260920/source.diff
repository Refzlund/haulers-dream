+                    Evidence.Require(composed.Count(x => ReferenceEquals(x, option)) == 1, "Adequate or unknown original option was replaced: " + before.mode);
+                    continue;
+                }
+                Evidence.Require(!composed.Any(x => ReferenceEquals(x, option)), "Inadequate IT proxy was retained: " + before.mode);
+                var actual = composed.Select(Bindings.Describe).Single(x => x.kind == "plain" && x.mode == before.mode && x.capturedBill == before.capturedBill);
+                string expectedImage = before.mode == "TargetCount" ? "HaulersDream" : before.mode == "W_PerTag" ? "Inventory" : "Everybody_Gets_One";
+                Evidence.Require(actual.assembly == expectedImage && actual.action != before.action, "IT proxy replacement did not use its actual authoritative action: " + before.mode);
+                replacements.Add(before.mode + ": option " + before.option + " -> " + actual.option + "; action " + before.mvid + "/" + before.token + " -> " + actual.mvid + "/" + actual.token);
+            }
+            row.replacedProxies = replacements.ToArray();
