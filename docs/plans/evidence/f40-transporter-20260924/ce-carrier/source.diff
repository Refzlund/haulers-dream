+using System;
+using System.Linq;
+using RimWorld;
+using RimWorld.Planet;
+using UnityEngine;
+using Verse;
+namespace HaulersDream.F40Persistence { public sealed partial class TransporterPersistence {
+        private bool NoTemperatureConditions() => map.gameConditionManager.ActiveConditions.Concat(Find.World.gameConditionManager.ActiveConditions).All(c => c.TemperatureOffset() == 0f);
+        private void ControlEnvironment()
+        {
+            Guard(!map.IsPocketMap && map.Tile.Layer is SurfaceLayer && !map.Biome.constantOutdoorTemperature.HasValue && NoTemperatureConditions(), "Ordinary native private surface required.");
+            var temp = Find.World.tileTemperatures; temp.ClearCaches(); float min = float.MaxValue, max = float.MinValue;
+            environmentEnd = checked(ticks.TicksAbs + 80000);
+            for (int t = ticks.TicksAbs; t <= environmentEnd; t++) { float value = temp.OutdoorTemperatureAt(map.Tile, t); Guard(!float.IsNaN(value) && !float.IsInfinity(value), "Finite native forecast required."); min = Math.Min(min, value); max = Math.Max(max, value); }
+            float offset = 20f - (min + max) / 2f; int packed = Mathf.Clamp(Mathf.RoundToInt((map.TileInfo.temperature + offset + 300f) * 10f), 0, 65535);
+            float mean = packed / 10f - 300f; offset = mean - map.TileInfo.temperature;
+            Guard(min + offset >= 8.5f && max + offset <= 29.5f, "Forecast does not fit native courier envelope.");
+            originalMean = map.TileInfo.temperature; climateCaptured = true; map.TileInfo.temperature = mean; temp.ClearCaches();
+            Record("native-climate-input", true, "original=" + F(originalMean) + "; mean=" + F(mean) + "; min=" + F(min + offset) + "; max=" + F(max + offset));
+        }
+        private bool WarmReady()
+        {
+            Guard(actor == null && ticks.TicksGame - warmStart <= 360, "Native room warmup must precede measured actors/cargo/jobs.");
+            ObserveEnvironment();
+            bool ready = arena.ContractedBy(1).Cells.All(c => c.GetRoom(map)?.UsesOutdoorTemperature == true
+                && GenTemperature.GetTemperatureForCell(c, map) >= 8f && GenTemperature.GetTemperatureForCell(c, map) <= 30f);
+            if (!ready || ticks.TicksGame <= warmStart) return false;
+            Record("actual-room-cache-ready", true, "tick=" + ticks.TicksGame + "; start=" + warmStart + "; actors=0; medical inputs untouched"); return true;
+        }
+        private void ObserveEnvironment()
+        { Guard(ticks.TicksAbs <= environmentEnd && NoTemperatureConditions() && map.mapTemperature.OutdoorTemp >= 8f && map.mapTemperature.OutdoorTemp <= 30f
+            && (actor == null || actor.AmbientTemperature >= 8f && actor.AmbientTemperature <= 30f), "Native environment left forecast/room bounds."); }
+    }
+}
